# Copie este arquivo para `docker/hermes/.env` (não versionado) e preencha sua chave.

# Obrigatória: chave de API do OpenRouter
OPENROUTER_API_KEY=

# Modelo padrão usado no OpenRouter (perfil global e perfil `sexta-feira`)
HERMES_MODEL=anthropic/claude-sonnet-4

# Imagem oficial do Hermes Agent (fixe uma tag se quiser evitar atualizações automáticas)
HERMES_IMAGE=nousresearch/hermes-agent:latest

# Dashboard web do Hermes (`0` desabilita por padrão; para `1`, configure usuário/senha ou OAuth)
HERMES_DASHBOARD=0

# Portas locais expostas em 127.0.0.1 (caso habilite gateway/dashboard)
HERMES_GATEWAY_PORTA=8642
HERMES_DASHBOARD_PORTA=9119
