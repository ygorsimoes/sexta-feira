{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "initial-version": "0.1.0",
  "include-component-in-tag": false,
  "include-commit-authors": true,
  "always-update": true,
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "pull-request-header": "🚀 **Nova versão pronta para publicação**\n\nAo fazer o **merge** desta PR na `main`, serão gerados automaticamente:\n- 🏷️ **Tag e GitHub Release** com as notas abaixo e atualização do `CHANGELOG.md`\n- 📦 **Binários pré-compilados** (`x86_64-unknown-linux-musl`, `aarch64-unknown-linux-musl`, `aarch64-apple-darwin`) + `SHA256SUMS.txt`",
  "pull-request-footer": "🤖 *Gerado automaticamente pelo [Release Please](https://github.com/googleapis/release-please).*",
  "changelog-sections": [
    { "type": "feat", "section": "✨ Funcionalidades" },
    { "type": "fix", "section": "🐛 Correções" },
    { "type": "perf", "section": "⚡ Performance" },
    { "type": "revert", "section": "⏪ Reversões" },
    { "type": "docs", "section": "📚 Documentação" },
    { "type": "refactor", "section": "♻️ Refatoração" },
    { "type": "ci", "section": "⚙️ CI/CD" },
    { "type": "style", "section": "🎨 Estilo", "hidden": true },
    { "type": "test", "section": "🧪 Testes", "hidden": true },
    { "type": "build", "section": "🏗️ Build", "hidden": true },
    { "type": "chore", "section": "🧹 Manutenção", "hidden": true }
  ],
  "packages": {
    ".": {
      "extra-files": [
        {
          "type": "toml",
          "path": "Cargo.toml",
          "jsonpath": "$.workspace.package.version"
        },
        {
          "type": "toml",
          "path": "Cargo.lock",
          "jsonpath": "$.package[?(@.name.value=='sexta-feira-core' || @.name.value=='sexta-feira-adapters' || @.name.value=='sexta-feira-cli')].version"
        }
      ]
    }
  }
}
